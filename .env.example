# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production
DEBUG=false

# ─── Observability / Logging (Phase 27.1D) ─────────────────────────────────────
# LOG_LEVEL: root level for the stdout handler. INFO surfaces the structured
#   telemetry events (http_request, discovery_run_*, report_validation) in the
#   staging container log stream. Set WARNING to reduce verbosity later.
# REQUEST_LOGGING_ENABLED: emit one http_request line per request (method/path/
#   status/duration/request_id). Never logs headers, bodies, query strings, or
#   secrets. Set false to silence per-request logging.
LOG_LEVEL=INFO
REQUEST_LOGGING_ENABLED=true

# ─── Database (local Docker) ───────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://investingbuddy:investingbuddy@localhost:5432/investingbuddy

# ─── LLM Provider (Phase 7) ───────────────────────────────────────────────────
# Select LLM client: mock (default, no credentials) | azure_openai
# Default is "mock" — CI and local development require no Azure credentials.
LLM_PROVIDER=mock

# ─── Azure OpenAI ──────────────────────────────────────────────────────────────
# Required only when LLM_PROVIDER=azure_openai.
# Staging resource: ib-stg-openai (westeurope, S0). Model: gpt-4.1-mini v2025-04-14.
# Never hardcode real keys. Store in Azure Key Vault (ib-stg-kv) for staging/production.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=

# ─── LLM Analysis Council (Phase 28A) ─────────────────────────────────────────
# A real but controlled, internal-only, citation-bound, safety-gated LLM council
# for SINGLE-company report synthesis. OFF by default — CI and a plain deploy
# stay fully deterministic (the report honestly reports "LLM: not used").
# Enable ONLY with a provider configured securely (never commit real keys).
LLM_COUNCIL_ENABLED=false
# Council client backend: fake (deterministic, offline — the ONLY provider tests
# use) | azure_openai | openai.
LLM_PROVIDER_COUNCIL=fake
# Model / OpenAI model id (informational for azure_openai; the deployment routes).
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1200
LLM_REQUEST_TIMEOUT_SECONDS=40
# Hard cap on evidence items passed to the council (bounds prompt size + cost).
LLM_COUNCIL_MAX_EVIDENCE_ITEMS=40
LLM_COUNCIL_VERSION=v1
# OpenAI-compatible fallback key — required only when LLM_PROVIDER_COUNCIL=openai.
# Never hardcode. Never logged. Never exposed in /health.
OPENAI_API_KEY=
# The azure_openai council reuses AZURE_OPENAI_ENDPOINT / _API_KEY /
# _API_VERSION / _DEPLOYMENT_NAME above (no separate council credentials).

# ─── LLM Discovery Council (Phase 28B) ────────────────────────────────────────
# A run-LEVEL LLM council that reviews a whole discovery run's candidate set and
# decides internal research PRIORITY (research_next / monitor_for_evidence /
# insufficient_data / reject_for_now). Internal-only, citation-bound,
# safety-gated. Manual admin-triggered ONLY — it never runs automatically after a
# discovery run. Gated by BOTH LLM_COUNCIL_ENABLED (the shared client gate) AND
# the flag below; when either is off, the council is disabled and no fake output
# is produced in production. Reuses LLM_PROVIDER_COUNCIL / LLM_MODEL /
# LLM_TEMPERATURE / LLM_REQUEST_TIMEOUT_SECONDS and the same provider
# credentials as the Phase 28A council. It does NOT use LLM_MAX_OUTPUT_TOKENS —
# see LLM_DISCOVERY_MAX_OUTPUT_TOKENS_* below.
LLM_DISCOVERY_COUNCIL_ENABLED=false
# ─── LLM Discovery Council Reliability / Retries (Phase 32A Slice 6A) ────────
# OFF by default: with LLM_DISCOVERY_COUNCIL_RETRY_ENABLED=false the discovery
# council runs exactly as before (one attempt per agent, no retries, no chair
# fallback). When true it retries ONLY transiently-failed agents (429 / timeout
# / temporary 5xx), never permanent failures (schema-invalid after repair,
# auth/config, safety rejection, or LLMJsonError — always permanent). Retries
# use capped exponential backoff + jitter and honor a capped provider
# retry-after, all under a total wall-time budget. A reserve protects
# run_red_team + discovery_chair; if the LLM chair still cannot complete, a
# deterministic, non-consensus discovery-chair summary is attached
# (run_quality="failed", no recommendation/valuation/price language, no
# citations). Unlike the company council (LLM_COUNCIL_RETRY_ENABLED above),
# the discovery council runs as an ASYNC background job with no inline HTTP
# gateway timeout, so its budget/reserve defaults are materially larger.
LLM_DISCOVERY_COUNCIL_RETRY_ENABLED=false
# Extra retry attempts for optional (non-critical) agents.
LLM_DISCOVERY_COUNCIL_RETRY_MAX_RETRIES=2
# Extra retry attempts for critical agents (run_coordinator, risk_gatekeeper,
# run_red_team, discovery_chair).
LLM_DISCOVERY_COUNCIL_RETRY_CRITICAL_MAX_RETRIES=3
# Exponential-backoff base (seconds): wait = base * 2**(attempt-1) + jitter.
LLM_DISCOVERY_COUNCIL_RETRY_BASE_BACKOFF_SECONDS=1.0
# Hard ceiling (seconds) on a single computed backoff wait.
LLM_DISCOVERY_COUNCIL_RETRY_MAX_BACKOFF_SECONDS=60.0
# Hard ceiling (seconds) on an honored provider retry-after (a hostile/large
# header can never blow the wall-time budget).
LLM_DISCOVERY_COUNCIL_RETRY_MAX_RETRY_AFTER_SECONDS=90.0
# TOTAL discovery-council wall-time budget (seconds) bounding the initial pass
# + all retries. Materially higher than the company council's 150s: the
# discovery council is an async background job, not bound by the inline
# gateway timeout.
LLM_DISCOVERY_COUNCIL_RETRY_TOTAL_BUDGET_SECONDS=300.0
# Wall-time (seconds) reserved out of the total budget for run_red_team +
# discovery_chair so earlier agents draining the budget cannot starve them.
LLM_DISCOVERY_COUNCIL_RETRY_CRITICAL_RESERVE_SECONDS=60.0
# Inter-agent pacing (seconds) inside the INITIAL pass when retries are ON. The
# pass is already strictly sequential; without pacing all 8 agents fire
# back-to-back at one deployment within seconds and trip short-window rate
# limits. Never applied after the last agent, never when it would cross the
# deadline, never in the retry pass (which has its own backoff). Discovery
# council ONLY — the shared retry engine defaults to no pacing, so the company
# and field-review councils are unchanged. 0.0 disables it.
LLM_DISCOVERY_COUNCIL_INITIAL_PASS_DELAY_SECONDS=1.5
# Hard cap on candidates included in the council evidence pack (bounds cost).
LLM_DISCOVERY_COUNCIL_MAX_CANDIDATES=25
LLM_DISCOVERY_COUNCIL_VERSION=v1
# Per-agent OUTPUT-token budget for the discovery council, computed ONCE per run:
#   min(CAP, BASE + PER_CANDIDATE * candidate_count)
# This council's JSON contract carries one candidate_notes entry PER CANDIDATE,
# so its reply grows with the candidate count — unlike the single-company
# council's fixed-size shape. Sharing the flat LLM_MAX_OUTPUT_TOKENS (1200)
# truncated the reply mid-object on multi-candidate runs, which surfaced as a
# PERMANENT LLMJsonError (malformed JSON is never retried and the one-shot
# repair reuses the same budget). Cost/reliability control only: it never
# changes what the council may output.
LLM_DISCOVERY_MAX_OUTPUT_TOKENS_BASE=1200
LLM_DISCOVERY_MAX_OUTPUT_TOKENS_PER_CANDIDATE=200
LLM_DISCOVERY_MAX_OUTPUT_TOKENS_CAP=5000

# ─── Deep Field Review (Phase 32A Slice 6D) ───────────────────────────────────
# A THIRD, SEPARATE council. NOT the Discovery Council above (which triages a
# candidate LIST before any analysis exists) and NOT the single-company council
# (which analyses ONE company). The Deep Field Review runs AFTER 2+ candidates
# from the SAME discovery run already have a COMPLETED full analysis, and
# compares those already-persisted reports to produce an internal
# RESEARCH-PRIORITY shortlist. It reads persisted data only — it never re-runs an
# analysis, never fetches new data, and never produces a rating, price target,
# fair value, or return projection. Manual admin-triggered, async, human review
# required. Gated by BOTH LLM_COUNCIL_ENABLED and the flag below.
LLM_FIELD_REVIEW_COUNCIL_ENABLED=false
# Hard cap on companies included in ONE field-review pack (bounds prompt cost).
LLM_FIELD_REVIEW_COUNCIL_MAX_COMPANIES=12
LLM_FIELD_REVIEW_COUNCIL_VERSION=v1
# Minimum candidates with a usable completed analysis before a COMPARATIVE
# review is meaningful. Below this the API returns 422 — never a silent review.
FIELD_REVIEW_MIN_CANDIDATES=2
# Bounded retry policy (attempt caps + total deadline + capped jittered backoff).
# The budget is larger than the single-company council's because the field review
# runs as an async background job, not inline in a request.
LLM_FIELD_REVIEW_COUNCIL_RETRY_ENABLED=true
LLM_FIELD_REVIEW_COUNCIL_MAX_RETRIES=2
LLM_FIELD_REVIEW_COUNCIL_CRITICAL_MAX_RETRIES=3
LLM_FIELD_REVIEW_COUNCIL_RETRY_BASE_BACKOFF_SECONDS=1.0
LLM_FIELD_REVIEW_COUNCIL_RETRY_MAX_BACKOFF_SECONDS=60.0
LLM_FIELD_REVIEW_COUNCIL_RETRY_MAX_RETRY_AFTER_SECONDS=90.0
LLM_FIELD_REVIEW_COUNCIL_TOTAL_BUDGET_SECONDS=600.0
LLM_FIELD_REVIEW_COUNCIL_CRITICAL_RESERVE_SECONDS=120.0

# ─── Azure Blob Storage ────────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=investingbuddy-documents

# ─── Azure AI Search ───────────────────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=investingbuddy-research

# ─── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─── Admin Auth Proxy (Phase 17) ───────────────────────────────────────────────
# Required on ib-stg-web App Service so the Next.js proxy can reach the backend.
# BACKEND_API_BASE_URL: full URL of the FastAPI backend (no trailing slash).
# BACKEND_BASIC_AUTH: "username:password" — must match STAGING_BASIC_AUTH on the API.
# NEVER use NEXT_PUBLIC_ prefix for BACKEND_BASIC_AUTH; it must remain server-only.
# This is now server-to-server defense only: the browser authenticates against
# the admin session (Phase 23) before the proxy ever attaches this credential.
BACKEND_API_BASE_URL=http://localhost:8000
BACKEND_BASIC_AUTH=

# ─── Admin Authentication (Phase 23) ───────────────────────────────────────────
# Protects /admin/* pages and /api/admin/proxy/* with an authenticated,
# allowlisted admin session (HMAC-signed httpOnly cookie). All server-only —
# NEVER prefix any of these with NEXT_PUBLIC_.
#
# AUTH_SECRET: long random string used to sign session cookies. Required.
#   Generate with:  openssl rand -base64 32
#   Store in Azure Key Vault (ib-stg-kv) as 'auth-secret'. Never commit a value.
AUTH_SECRET=
# Trust reverse-proxy forwarded host/proto headers (Azure App Service). Set true
# in staging/production so OAuth redirect URIs resolve to the public hostname.
AUTH_TRUST_HOST=true
# Optional explicit external origin (overrides forwarded-header detection):
#   AUTH_URL=https://ib-stg-web.azurewebsites.net
AUTH_URL=
# Comma-separated allowlist of admin emails. Only these accounts may access
# /admin/*. Anyone else who signs in is sent to /unauthorized (403 on the proxy).
ADMIN_ALLOWED_EMAILS=

# GitHub OAuth app credentials (real staging/production sign-in). Create a
# GitHub OAuth App with callback URL <AUTH_URL>/api/auth/callback/github.
# Never commit real values — store the secret in Azure Key Vault.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# LOCAL DEV / CI ONLY: enable a deterministic credential sign-in at
# /api/auth/dev-login (no OAuth round-trip). MUST remain unset/false in
# staging and production — it is a test convenience, not a production login.
AUTH_TEST_MODE=false

# ─── Financial Data Provider (Phase 4) ────────────────────────────────────────
# Select provider: mock | eodhd | sec_edgar | stooq | openbb | gleif
# Default is "mock" — CI and local development work with no credentials.
FINANCIAL_DATA_PROVIDER=mock

# EODHD credentials — required only when FINANCIAL_DATA_PROVIDER=eodhd.
# Never hardcode. Store in Azure Key Vault for staging/production.
EODHD_API_KEY=
EODHD_BASE_URL=https://eodhd.com/api

# ─── Live Provider Integration Tests (Phase 5) ────────────────────────────────
# Set to true ONLY for local manual integration testing with live network.
# Leave false (or unset) in CI — CI must always run offline.
ENABLE_INTEGRATION_TESTS=false

# ─── EODHD Live Integration Tests (Phase 13) ──────────────────────────────────
# Set to true ONLY for local manual testing with a real EODHD_API_KEY.
# Requires EODHD_API_KEY to be set. Never set in CI.
ENABLE_EODHD_INTEGRATION_TESTS=false

# ─── Staging Access Control (Phase 12) ────────────────────────────────────────
# Protects the staging API with HTTP Basic Auth when APP_ENV=staging.
# Format: "username:password" — leave empty in local development.
# Store in Azure Key Vault (ib-stg-kv) as 'staging-basic-auth' for staging.
# Never set this in production — use proper authentication (Clerk/Entra).
STAGING_BASIC_AUTH=

# ─── Auth (Clerk) ──────────────────────────────────────────────────────────────
# Not yet wired in Phase 1. Add when authentication is implemented.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── Catalyst News / Search Provider (Phase 24.1) ─────────────────────────────
# Optional and NON-BLOCKING. With everything below unset, catalyst discovery
# still runs (SEC filings + curated/discovered company press-release feeds) and
# the report shows an explicit "news provider not configured" warning.
#   - unset / "none"  → offline NullNewsProvider (default; CI must stay offline)
#   - "gdelt"         → no-key GDELT 2.1 DOC API adapter
#   - any other name  → env-key ConfigurableWebNewsProvider (needs KEY + BASE_URL)
# NEVER commit a real NEWS_API_KEY — store it in Azure Key Vault for staging.
NEWS_PROVIDER_NAME=
NEWS_API_KEY=
NEWS_API_BASE_URL=
NEWS_SEARCH_ENDPOINT=
NEWS_MAX_RESULTS=10
NEWS_LOOKBACK_DAYS=90
NEWS_TIMEOUT_SECONDS=8

# ─── Market Candidate Discovery (Phase 25) ───────────────────────────────────
# Internal-only, bounded market scan that produces an internal research
# candidate queue. NOT a recommendation engine; never runs an uncontrolled
# full-market scan. Defaults are deliberately conservative.
#   - DISCOVERY_DEFAULT_PROVIDER: free_real (recommended) | eodhd_free_real | mock
#   - DISCOVERY_MAX_UNIVERSE_SIZE: hard cap; a larger run is rejected (422)
#   - DISCOVERY_MAX_CONCURRENT_REQUESTS: kept small (1–2) to be polite to free sources
#   - DISCOVERY_LOOKBACK_DAYS: price/catalyst lookback window
#   - DISCOVERY_SEED_UNIVERSE: comma-separated curated seed (kept under the max)
DISCOVERY_DEFAULT_PROVIDER=free_real
DISCOVERY_MAX_UNIVERSE_SIZE=15
DISCOVERY_MAX_CONCURRENT_REQUESTS=1
DISCOVERY_LOOKBACK_DAYS=90
DISCOVERY_REQUEST_TIMEOUT_SECONDS=30
DISCOVERY_CACHE_TTL_HOURS=0
DISCOVERY_SEED_UNIVERSE=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA

# ─── Source Registry + Connector Framework (Phase 29A) ───────────────────────
# The unified source registry (app/services/sources/) is code-defined and
# introduces NO new required environment variables. Connector health is derived
# from EXISTING settings without ever exposing a secret — e.g. the `eodhd`
# connector reports `configured` / `not_configured` from EODHD_API_KEY above.
# Registry entries never store credentials; /api/v1/sources/registry and
# /api/v1/sources/health are read-only and secret-free.
#
# The Phase 29C macro / commodity-energy references (FRED, IMF, Eurostat, World
# Bank Pink Sheet, national stats — 29C.1; USGS, EIA, IEA, IRENA, ENTSO-E — 29C.2)
# are ENABLED but reference-only and keyless (fixed public URLs, no live figures),
# gated OFF by default behind SOURCE_MACRO_ENABLED — no API key belongs here.
# The still-planned external-source connectors (OpenBB, USTR/TARIC, USAspending,
# EU TED, UN Comtrade, patents, …) are DISABLED placeholders; their optional API
# keys will be added here in later connector phases (29C.3–29D) — always via Azure
# Key Vault in staging/production, never committed.

# ─── Source Connector Framework (Phase 29B) ──────────────────────────────────
# Phase 29B wires the SEC EDGAR + company-IR connectors into the single-company
# evidence pack and adds honest gaps for the scaffolded regulator connectors
# (SEDAR+, ASX — class exists, live fetch pending, never fabricated). Phase
# 29B.4A promoted UK FCA NSM, 29B.4B promoted Euronext (Paris/Amsterdam
# regulated-information + AMF/AFM), and 29B.4C promoted Deutsche Börse
# (Bundesanzeiger / BaFin) + Nordic (Nasdaq Nordic / Finanstilsynet) and added a
# new SIX Swiss connector — each a dedicated regulator connector emitting a T2
# venue reference + honest content gap (network-free at report time; no new env
# var). No new required env vars.
#
# SOURCE_CONNECTOR_ENABLED gates whether the connector layer feeds evidence into
# the evidence pack. OFF by default so CI and a plain deploy keep the exact
# Phase 29A behaviour (planned/scaffold gaps are still recorded; no connector
# evidence is added, and no report-time network calls are made). When ON, the
# pack additionally includes bounded, tiered connector evidence built from data
# the workflow already fetched, and the read-only evidence-preview endpoint may
# perform bounded live fetches (SEC EDGAR + curated issuer feeds only — no
# arbitrary URL fetch). Conservative defaults.
SOURCE_CONNECTOR_ENABLED=false
SOURCE_CONNECTOR_MAX_ITEMS_PER_SOURCE=5
SOURCE_CONNECTOR_TIMEOUT_SECONDS=10
# Phase 32A corrective (Problem A) — a SEPARATE, bounded cap on structured
# (validated) financial facts the company-IR connector may contribute,
# reserved AHEAD of and independent of SOURCE_CONNECTOR_MAX_ITEMS_PER_SOURCE,
# so a small excerpt cap can never make the financial-fact floor
# mathematically unreachable. See app/services/sources/financial_fact_categories.py.
COMPANY_IR_FINANCIAL_FACT_CAP=12

# ─── Non-US Company IR Evidence (Phase 29B.1) ────────────────────────────────
# Phase 29B.1 adds a code-defined verified-issuer source registry (company-owned
# IR / annual-report / newsroom URLs for known non-US issuers — Richemont, LVMH,
# Kering, Burberry, Pandora, Moncler, Swatch, Hermès, …) so the company-IR
# connector can emit real T1 primary-company evidence where SEC EDGAR is not
# eligible. Report-time evidence is metadata-only (no network call); the
# read-only evidence-preview endpoint may do bounded, SSRF-safe live fetches of
# those allowlisted pages (annual-report / press-link discovery) — but ONLY when
# SOURCE_CONNECTOR_ENABLED=true, only to allowlisted issuer domains, HTTPS only.
# These caps apply to that live fetcher only; the report/council path never calls it.
SOURCE_CONNECTOR_MAX_BYTES=1000000
SOURCE_CONNECTOR_ALLOWLIST_ONLY=true
SOURCE_CONNECTOR_MAX_LINKS_PER_PAGE=25

# ─── Primary-Document Extraction (Phase 29B.2) ───────────────────────────────
# Phase 29B.2 adds bounded extraction of an issuer's OWN annual-report /
# registration-document text so the LLM council can reason from real T1 primary
# evidence — not only metadata + price/model data. OFF by default: with the flag
# off, the exact Phase 29B.1 behaviour is preserved (company-IR metadata evidence
# + honest gaps only, no document fetch). When ON *and* SOURCE_CONNECTOR_ENABLED
# is also on, the company-IR connector fetches ONE already-discovered, allowlisted
# annual-report document, extracts bounded excerpts and parses only high-confidence
# facts. Never fabricates a filing: a blocked / JS-gated / scanned document
# degrades to an honest source gap. No arbitrary-URL fetch surface — the document
# URL always comes from the verified-issuer registry / already-extracted links.
# No OCR in this phase. Staging may enable this during validation.
SOURCE_DOCUMENT_EXTRACTION_ENABLED=false
SOURCE_DOCUMENT_EXTRACTION_MAX_BYTES=5000000
SOURCE_DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=15
SOURCE_DOCUMENT_EXTRACTION_MAX_PAGES=20
SOURCE_DOCUMENT_EXTRACTION_MAX_EXCERPTS=8
SOURCE_DOCUMENT_EXTRACTION_MAX_CHARS_PER_EXCERPT=1200
SOURCE_DOCUMENT_EXTRACTION_ALLOWED_CONTENT_TYPES=application/pdf,text/html,text/plain

# ─── LLM Council Evidence Budget (Phase 29B.2) ───────────────────────────────
# A deterministic budgeter compresses the evidence pack before it reaches the
# council (de-dup + tier-preferring truncation + char bounds) so a larger
# primary-source pack cannot balloon the prompt and trip the Azure OpenAI TPM
# quota. Applied only when SOURCE_CONNECTOR_ENABLED=true (staging). Source gaps
# are always retained; stable citation ids E1..En are preserved.
LLM_COUNCIL_EVIDENCE_MAX_ITEMS=20
LLM_COUNCIL_EVIDENCE_MAX_CHARS=24000
LLM_COUNCIL_EVIDENCE_MAX_CHARS_PER_ITEM=1200

# Floor of price/market-metric slots RESERVED in the council evidence pack
# (product readiness, 2026-08-22). The Valuation Guard agent reported "No
# current market price or share price data is provided" in a report whose own
# Financial Snapshot showed latest close 214.72 USD — the T5/T6 price items had
# been crowded out of the 20-slot pack by the financial-fact floor plus T1
# issuer press. All council agents share one pack, so reserving a small floor
# is what makes the guard reason about the real price instead of asserting its
# absence to a human reader. Bounded by LLM_COUNCIL_EVIDENCE_PRICE_TREND_CAP.
LLM_COUNCIL_EVIDENCE_PRICE_TREND_FLOOR=2

# ─── LLM Council Reliability / Retries (Phase 32A Slice 4) ───────────────────
# OFF by default: with LLM_COUNCIL_RETRY_ENABLED=false the council runs exactly
# as before (one attempt per agent, no retries, no chair fallback). When true it
# retries ONLY transiently-failed agents (429 / timeout / temporary 5xx), never
# permanent failures (schema-invalid after repair, auth/config, safety rejection).
# Retries use capped exponential backoff + jitter and honor a capped provider
# retry-after, all under a strict TOTAL wall-time budget. Phase 32A TPM slice:
# the full analysis is an ASYNC background job (PR #119), so the budgets below
# are async-era sized — they may span multiple provider TPM refill windows. A
# reserve protects red_team + committee_chair; if the LLM chair still cannot
# complete, a deterministic, non-consensus committee summary is attached
# (label "insufficient_data", no recommendation/valuation/price language, no
# citations) and the persisted payload carries committee_label_basis=
# "deterministic_fallback" + chair_error_type so an infrastructure failure can
# never masquerade as an evidence judgement. publication_ready stays false and
# human_review_required stays true.
LLM_COUNCIL_RETRY_ENABLED=false
# Extra retry attempts for optional (non-critical) agents.
LLM_COUNCIL_MAX_RETRIES=2
# Extra retry attempts for critical agents (financial_analyst, source_quality_critic,
# red_team, committee_chair, and valuation_guard when financial evidence exists).
LLM_COUNCIL_CRITICAL_MAX_RETRIES=3
# Exponential-backoff base (seconds): wait = base * 2**(attempt-1) + jitter.
LLM_COUNCIL_RETRY_BASE_BACKOFF_SECONDS=1.0
# Hard ceiling (seconds) on a single computed backoff wait.
LLM_COUNCIL_RETRY_MAX_BACKOFF_SECONDS=60.0
# Hard ceiling (seconds) on an honored provider retry-after (a hostile/large
# header can never blow the wall-time budget). Azure suggests ~60s under TPM
# exhaustion — the old 30s cap guaranteed the retry hit the same window.
LLM_COUNCIL_RETRY_MAX_RETRY_AFTER_SECONDS=90.0
# Strict TOTAL council wall-time budget (seconds) bounding the initial pass +
# all retries. Async-era value: a ~48k-token council against a 10k-TPM
# deployment needs >= 5 minutes of refill windows. Still strictly bounded.
LLM_COUNCIL_TOTAL_BUDGET_SECONDS=600.0
# Wall-time (seconds) reserved out of the total budget for red_team +
# committee_chair so earlier agents draining the budget cannot starve them.
LLM_COUNCIL_CRITICAL_RESERVE_SECONDS=180.0
# Inter-agent pacing (seconds) inside the company council's initial pass when
# the retry bundle is on (same mechanism the discovery council uses). 0 = off.
LLM_COUNCIL_INITIAL_PASS_DELAY_SECONDS=0.0

# ─── Provider-Aware Token Pacing (Phase 32A TPM slice) ───────────────────────
# Shared by ALL THREE councils (company / discovery / field review) — they call
# the same Azure OpenAI deployment, so they share one process-local
# tokens-per-minute window. 0 disables pacing entirely (default).
# Staging: set to the deployment's real quota (e.g. 10000 for the current
# GlobalStandard capacity-10 gpt-4.1-mini deployment).
LLM_COUNCIL_TPM_CAPACITY=0
# Tokens withheld from NON-chair agents in each window so the chair (last and
# largest request) always finds headroom. Clamped to half the capacity.
LLM_COUNCIL_CHAIR_TOKEN_RESERVE=4000
# Hard ceiling (seconds) a single paced request may wait for window headroom
# before proceeding anyway (pacing is advisory; the provider 429 + bounded
# retries are the correctness backstop).
LLM_COUNCIL_PACING_MAX_WAIT_SECONDS=240.0
# Per-agent cap (characters) on each prior summary in the committee chair's
# user message. 0 = no compaction (byte-identical chair prompt). When > 0 each
# completed agent keeps a truncated summary + its cited evidence ids, top
# risks and unsupported-claim count — conclusions and dissent are never lost.
LLM_COUNCIL_CHAIR_PRIOR_SUMMARY_MAX_CHARS=0
# Base minutes before a "running" analysis-job envelope from a dead worker is
# treated as abandoned/restartable. The EFFECTIVE threshold is max(this, the
# derived council+pacing+ingestion worst case + margin) — raising a council
# budget can never silently make a legitimate long job look stale.
ANALYSIS_JOB_STALE_AFTER_MINUTES=45

# ─── Macro Reference Evidence Layer (Phase 29C.1) ────────────────────────────
# Phase 29C.1 adds a reference-only MACRO evidence layer over five official
# public sources (FRED, IMF, Eurostat, World Bank Commodity Pink Sheet, national
# statistics offices / central banks). OFF by default: with the flag off the
# macro collector is completely dark (no macro evidence, no macro gaps) and the
# discovery pack + report body are byte-identical to Phase 29B. When ON, the
# collector emits bounded T2 macro SOURCE REFERENCES (which official dataset
# covers which indicators) plus an honest "figures not fetched" gap — it is
# REFERENCE-ONLY: NO live figures / index levels / release dates / forecasts, NO
# report-time network, and NO API key (FRED-style keys are deliberately not
# supported; the connectors point only at fixed, public, token-free landing
# pages). Never a recommendation or valuation.
SOURCE_MACRO_ENABLED=false
# Hard cap on macro source references collected for one theme/region.
SOURCE_MACRO_MAX_ITEMS=3

# ─── Procurement / Tender Event-Trigger Reference Layer (Phase 29D.1) ─────────
# Phase 29D.1 adds a reference-only, event-trigger evidence category (parallel to
# the 29C macro layer) over two official public procurement/tender venues — EU
# TED (ted.europa.eu) and USAspending.gov (usaspending.gov). OFF by default and
# INDEPENDENT of SOURCE_MACRO_ENABLED: with the flag off the event collector is
# completely dark (no event evidence, no event gaps) and the discovery pack +
# report body are byte-identical to the macro-only layer. When ON, the collector
# emits — per relevant theme — ONE bounded T2 SOURCE REFERENCE (a fixed official
# public procurement/tender landing URL) plus an honest "live tenders/awards not
# fetched at report time" gap. It is REFERENCE-ONLY: NO specific
# tender/award/contractor/amount/contract-number/date is ever emitted, NO
# report-time network fetch, and NO API key. Each reference is a WEAK internal
# research-priority signal that carries needs_human_review and records freshness
# via stale_after_days — it is NOT a materiality claim, candidate, catalyst, or
# trade signal, and never a recommendation or valuation.
SOURCE_EVENT_ENABLED=false
# Hard cap on event-trigger source references collected for one theme/region.
SOURCE_EVENT_MAX_ITEMS=3

# ─── Language Detection + Machine-Translation Foundation (Phase 30A) ──────────
# Phase 30A adds a language DETECTOR (en/fr/de/it/da) plus a bounded,
# honestly-marked machine-translation FOUNDATION so a council can read a
# non-English T1 primary source for research context. OFF by default. When ON,
# only ONE bounded excerpt at a time is translated (NEVER a whole document); the
# ORIGINAL text + source URL are always preserved; and every result is
# machine-assisted, carries a "NOT an official translation — human review
# required" warning, and sets needs_human_review. A translation is exposed as
# council metadata (source_summary_json.llm_council.translated_excerpts) + an
# optional report block (translated_evidence) — each keeps the original source
# URL as the citation of record — and is NEVER injected into the evidence pack
# and NEVER presented as official. No recommendation or valuation.
SOURCE_TRANSLATION_ENABLED=false
# Hard cap on characters per translated excerpt (bounds BOTH input and output so
# a whole filing is never sent to a translation provider).
SOURCE_TRANSLATION_MAX_CHARS=400
# Max number of excerpts translated for one company/source.
SOURCE_TRANSLATION_MAX_EXCERPTS=3
# Translation backend: "fake" (deterministic honest placeholder — the DEFAULT,
# never fabricates fluent English) or "llm" (composes the existing Azure OpenAI
# client — no new host/model/secret; logs ONLY counts + language codes, never
# the prompt/original/translated text). "llm" is only ever resolved when this is
# "llm" AND SOURCE_TRANSLATION_ENABLED=true AND an LLM client is available.
TRANSLATION_PROVIDER=fake

# Internal research memo builder (Phase 31, the FINAL campaign phase). OFF by
# default. When true, the final-report generator attaches an internal
# `research_memo` section to report_content — a DETERMINISTIC synthesis of the
# already-assembled report sections + LLM council metadata + known source gaps
# (no external call, no LLM, no ORM, no recompute). It is internal-admin-only,
# citation-bound (each claim ties to an existing source/citation), degrades
# honestly when evidence is thin (surfaces what is missing, never fabricates),
# and NEVER produces a recommendation or valuation (no BUY/SELL/HOLD/WATCH, price
# target, fair value, or upside/downside — those literals appear only inside the
# memo's scanner-exempt disallowed_outputs notice). human_review_required stays
# true and publication_ready stays false. With this off the report is
# byte-identical to the prior behaviour.
SOURCE_RESEARCH_MEMO_ENABLED=false

# ─── Primary-Document Ingestion (Phase 32A Slice 5) ───────────────────────────
# Bounded, allowlist-gated ingestion of an issuer's OWN primary documents
# (annual report / registration document) that DEEPENS Phase 29B.2 extraction:
# structured (SEC/XBRL, unchanged) → deepened HTML (stdlib HTMLParser: tables +
# headings/sections, boilerplate removed) → native PDF (pdfplumber: per-page text
# + table extraction with page/table location) → OCR fallback (NoOp seam ONLY
# this slice — see below). Runs in the source-connector phase inside
# maybe_run_council, BEFORE the council, under an AGGREGATE wall-budget so
# ingestion + the ~150s council budget stay under the ~230s gateway. Extraction
# results persist (extracted_documents / extracted_facts, migration 013) and are
# REUSED across report regeneration when a fresh persisted doc exists.
#
# OFF by default: with PRIMARY_DOCUMENT_INGESTION_ENABLED=false the deep path is
# never entered and every existing extraction / connector / council path is
# byte-for-byte unchanged (all knobs below are inert). Reuse is consulted ONLY
# when BOTH this flag AND REPORT_CITATION_PERSISTENCE_ENABLED are on. Never
# fabricates a filing: a blocked / JS-gated / scanned document degrades to an
# honest metadata-only / extraction_failed gap. No arbitrary-URL fetch surface —
# no endpoint accepts a user-supplied URL; every fetch routes through the
# allowlist-gated hardened fetch layer. Table/OCR-derived values pass stricter
# validation (label/value/unit/period + column alignment + cross-field arithmetic
# + cross-method agreement; OCR downgraded); non-validated text is kept
# excerpt_only, never a structured fact. Every extracted fact is
# needs_human_review and never a recommendation/valuation.
PRIMARY_DOCUMENT_INGESTION_ENABLED=false
# Optional OCR pass for scanned (image-only) PDFs. OFF by default AND gated behind
# the master flag. A real Azure Document Intelligence adapter exists
# (Phase 32A Slice 5B.2, see docs/DECISIONS.md ADR-016) but this flag ALONE does
# not activate it — AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT (below) must also be set,
# else get_ocr_provider() falls back to the honest NoOp provider (returns an empty
# ocr_unavailable result, never fabricated text) regardless of this flag.
PRIMARY_DOCUMENT_OCR_ENABLED=false
# Hard byte ceiling for a single fetched document (bounds memory; a larger
# document is rejected/truncated, never fully buffered).
PRIMARY_DOCUMENT_MAX_DOWNLOAD_BYTES=8000000
# Maximum number of leading PDF pages read (bounds native extraction cost).
PRIMARY_DOCUMENT_MAX_PDF_PAGES=40
# Maximum pages rastered + OCR'd when OCR is enabled (kept far below the native
# page cap because OCR is much more expensive).
PRIMARY_DOCUMENT_MAX_OCR_PAGES=5
# Per-document fetch timeout budget (seconds).
PRIMARY_DOCUMENT_FETCH_TIMEOUT_SECONDS=15
# Per-document text-extraction timeout budget (seconds).
PRIMARY_DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=20
# HARD per-document total timeout (seconds): fetch + extract + parse for ONE
# document must complete inside this.
PRIMARY_DOCUMENT_TOTAL_TIMEOUT_SECONDS=45
# AGGREGATE ingestion wall-time budget (seconds) across ALL documents in one
# request. Kept small: ingestion runs BEFORE the ~150s council budget and the
# whole request must fit the ~230s Azure gateway timeout.
PRIMARY_DOCUMENT_INGESTION_BUDGET_SECONDS=60
# Hard cap on documents ingested for one issuer in a single request.
PRIMARY_DOCUMENT_MAX_DOCS_PER_ISSUER=3
# Maximum number of bounded excerpts produced from one document.
PRIMARY_DOCUMENT_MAX_EXCERPTS_PER_DOCUMENT=8
# Hard cap on characters per excerpt (a whole filing is never carried around).
PRIMARY_DOCUMENT_MAX_EXCERPT_CHARS=1200
# Minimum extraction confidence [0..1] for a parsed fact to be kept as a validated
# fact; lower-confidence text is retained excerpt-only.
PRIMARY_DOCUMENT_MIN_EXTRACTION_CONFIDENCE=0.6
# Pillow decompression-bomb guard for the OCR raster path: refuse to decode an
# image larger than this many pixels.
PRIMARY_DOCUMENT_MAX_IMAGE_PIXELS=40000000
# Evidence-pack integration: guaranteed floor + hard cap on the number of
# primary-document facts contributed to the council evidence pack. Added ON only
# with the master flag; does NOT weaken the Slice-2 financial_floor=3 / news caps.
PRIMARY_DOCUMENT_EVIDENCE_FLOOR=1
PRIMARY_DOCUMENT_EVIDENCE_CAP=6
# Freshness window (hours) for REUSING a previously extracted primary document
# across a report regeneration (rebuilt from stored excerpts + validated facts,
# no re-fetch/re-extract). Older documents are re-fetched. Only consulted when
# BOTH PRIMARY_DOCUMENT_INGESTION_ENABLED and REPORT_CITATION_PERSISTENCE_ENABLED
# are on.
PRIMARY_DOCUMENT_REUSE_TTL_HOURS=24

# ── Primary-document reachability + secure fetch (Phase 32A Slice 5B.1) ──
# Slice 5A shipped the ingestion foundation but reached ZERO successful live
# extractions: US issuers had no SEC filing-BODY path at all, and modern issuer
# IR pages are JS-rendered so an <a href>-only scan found nothing. These knobs
# bound the fixes. All of them are inert unless
# PRIMARY_DOCUMENT_INGESTION_ENABLED (the master flag) is true.

# Resolve-then-connect IP pinning: the connection is made to the exact address
# that was validated, so a hostile DNS answer cannot change between the check and
# the connect (closes the ADR-014 rebinding TOCTOU). TLS SNI, the Host header and
# certificate verification all still use the real hostname — pinning changes
# WHERE we connect, never WHAT we trust. ON by default; this is a kill-switch,
# and turning it off reverts to the weaker Slice 5A check-then-connect behaviour.
PRIMARY_DOCUMENT_PIN_DNS_ENABLED=true

# Hard cap on document candidates kept from ONE issuer page across ALL discovery
# strategies (bounds parsing + ranking cost).
PRIMARY_DOCUMENT_MAX_DISCOVERY_CANDIDATES=12

# Ordered discovery strategies. Bounded, non-browser methods ONLY — there is
# deliberately no crawler and no headless browser. Anchors run first so existing
# behaviour is preserved; the rest read document URLs that a JS-rendered page
# already ships in its own markup (JSON-LD, Next.js/Nuxt hydration state,
# embedded script JSON).
PRIMARY_DOCUMENT_DISCOVERY_STRATEGIES=anchors,json_ld,next_data,embedded_json

# Official SEC filing-BODY retrieval for US issuers (10-K / 20-F / 10-Q / 6-K /
# 8-K). SUPPLEMENTS — never replaces — the SEC/XBRL structured facts, which stay
# authoritative for financial figures.
PRIMARY_DOCUMENT_SEC_BODY_ENABLED=true

# Hard cap on SEC filing bodies fetched for one issuer in a single request.
PRIMARY_DOCUMENT_SEC_MAX_BODIES=2

# Client-side throttle between SEC requests (milliseconds). SEC asks automated
# clients to declare a User-Agent and stay under ~10 requests/sec; this default
# is deliberately more conservative than the published ceiling.
SEC_REQUEST_MIN_INTERVAL_MS=120

# ── Real OCR: Azure Document Intelligence (Phase 32A Slice 5B.2 — CLOSED +
#    STAGING-VALIDATED 2026-08-09, docs/development/closures/phase-32a-slice5b2.md) ──
# Only ever consulted when PRIMARY_DOCUMENT_OCR_ENABLED is also true. Never
# hardcode — load from Azure Key Vault in staging/production. Managed identity
# (DefaultAzureCredential) is preferred over the API key when both are unset/set
# respectively — leave the key empty in any environment with a system-assigned
# managed identity (e.g. staging/production App Service). On staging, a real
# resource (`ib-stg-docintel`, F0/free tier, westeurope) is now provisioned and
# these settings are populated there via the API-key fallback (the deploying
# identity lacks the RBAC permission to grant managed identity access — see
# ADR-016's addendum); this file's values stay empty placeholders for every
# other environment and must never carry a real value.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=

# Hard cap for ONE OCR call (submit + poll), carved OUT OF — never added on top
# of — PRIMARY_DOCUMENT_TOTAL_TIMEOUT_SECONDS (45s).
PRIMARY_DOCUMENT_OCR_TIMEOUT_SECONDS=20

# Fixed poll interval (seconds) for the Azure long-running-operation status check.
PRIMARY_DOCUMENT_OCR_POLL_INTERVAL_SECONDS=1.0

# Cross-document cap on how many documents may go through OCR in a single
# report-generation request. Smaller than PRIMARY_DOCUMENT_MAX_DOCS_PER_ISSUER
# (3) because OCR is materially more expensive than native extraction.
PRIMARY_DOCUMENT_MAX_OCR_DOCUMENTS_PER_RUN=2

# Bounded retry count for a single transient (429 / 5xx) OCR failure. Never
# unbounded.
PRIMARY_DOCUMENT_OCR_MAX_RETRIES=1

# Below this confidence [0..1], OCR excerpts are retained as bounded evidence
# but never become validated-fact candidates.
PRIMARY_DOCUMENT_OCR_MIN_CONFIDENCE=0.4
